<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/S1">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blockTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding = "16dp"
        app:layout_constraintHeight_percent="0.13"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/pillPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_replay_button"
            android:paddingStart="6dp"
            android:paddingEnd="14dp"
            android:paddingVertical="6dp"
            app:layout_constraintStart_toEndOf="@id/btnBackLayout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="16dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatarPlayer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bot6"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_blue_border"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeWidth="2dp"
                app:strokeColor="@color/LCBlue"
                android:padding="2dp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/timePlayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/LCWhite"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/pillEnemy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_replay_button"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/timeEnemy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/LCWhite"
                android:layout_marginEnd="10dp"/>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatarEnemy"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/bot2"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_red_border"
                android:padding="2dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/LCRed"
                app:shapeAppearanceOverlay="@style/CircleImage"/>

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnBackLayout"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_go_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Salir"
                android:padding="8dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:tint="@color/LCWhite" />
        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blockMid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.72"
        app:layout_constraintTop_toBottomOf="@id/blockTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/boardReplay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_margin="6dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/replayControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_button"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toBottomOf="@id/blockMid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ir al inicio -->
        <ImageButton
            android:id="@+id/btnStart"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_double_arrow"
            android:rotation="180"
            android:contentDescription="Inicio"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:tag="double"
            app:tint="@color/LCWhite" />

        <!-- Un paso atrás -->
        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="Anterior"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"/>

        <!-- Un paso adelante -->
        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_left"
            android:rotation="180"
            android:contentDescription="Siguiente"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            app:tint="@color/LCWhite"/>

        <!-- Ir al final -->
        <ImageButton
            android:id="@+id/btnEnd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_double_arrow"
            android:contentDescription="Final"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:tag="double"
            app:tint="@color/LCWhite" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>