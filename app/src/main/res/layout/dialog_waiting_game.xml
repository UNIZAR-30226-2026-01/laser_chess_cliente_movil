<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:layout_gravity="center"
        android:backgroundTint="@color/S1"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <include
            android:id="@+id/dialog_top_section"
            layout="@layout/dialog_common_popup_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressWaitingGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:indeterminate="true"
            app:indicatorSize="80dp"
            app:trackThickness="8dp"
            app:indicatorColor="@color/LCBlue" />

            <TextView
                android:id="@+id/textWaitingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/LCWhite"
                android:text="Buscando partida"
                android:textSize="@dimen/text_medium_large"
                android:textStyle="bold"
                android:layout_marginBottom="1dp" />

            <TextView
                android:id="@+id/textWaitingOpponent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/LCWhite"
                android:text="Esperando a que el rival acepte la partida"
                android:textSize="@dimen/text_medium_small"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <ProgressBar
                android:id="@+id/progressWaitingGame"
                android:progressTint="@color/LCBlue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textWaitingDetails"
                android:textColor="@color/LCWhite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(...)"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonCancelChallengeRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Cancelar"
                android:textSize="16sp"
                android:textColor="@color/LCWhite"
                android:background="@drawable/bg_red_button"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>