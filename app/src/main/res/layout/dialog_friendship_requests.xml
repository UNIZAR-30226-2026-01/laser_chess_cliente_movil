<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dark_panel_rounded"
        android:padding="16dp">

        <include
            android:id="@+id/dialog_top_section"
            layout="@layout/dialog_common_popup_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Tabs -->
        <LinearLayout
            android:id="@+id/layoutRequestTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tabReceivedRequests"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="@string/received_requests"
                android:textColor="@color/selector_tab_text_color"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabSentRequests"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_unselected"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="@string/sent_requests"
                android:textColor="@color/selector_tab_text_color"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Contenido RECIBIDAS -->
        <LinearLayout
            android:id="@+id/layoutReceivedRequestsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textEmptyReceivedRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_received_requests"
                android:textSize="15sp"
                android:textColor="@color/LCGray"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/layoutReceivedRequestsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Contenido ENVIADAS -->
        <LinearLayout
            android:id="@+id/layoutSentRequestsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textEmptySentRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_sent_requests"
                android:textSize="15sp"
                android:textColor="@color/LCGray"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/layoutSentRequestsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>