<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_modal_border"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imageResult"
            android:layout_width="200dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_tablero_prov"
            android:scaleType="centerCrop"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/textResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Has ganado!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/LCWhite"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/textRewards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Has ganado 0 XP y 0 monedas"
            android:textSize="14sp"
            android:textColor="@color/LCWhite"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/textElo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elo: +0"
            android:textSize="14sp"
            android:textColor="@color/LCWhite"
            android:visibility="gone"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/buttonExit"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:text="Cerrar"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/LCWhite"
            android:background="@drawable/bg_modal_border"/>

    </LinearLayout>
</FrameLayout>