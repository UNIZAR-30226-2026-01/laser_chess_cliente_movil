<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/layoutLeagueBadge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
        android:id="@+id/layoutLeagueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="72dp"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:background="@drawable/bg_dark_pill_panel"

        android:paddingStart="24dp"
        android:paddingEnd="20dp"
        android:paddingVertical="12dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtLeagueName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="PROTON II · 1450 / 1499"
            android:textColor="@color/LCWhite"
            android:textStyle="bold"
            android:textSize="15sp"

            android:maxLines="1"
            android:ellipsize="end"

            android:gravity="center_vertical"
            android:includeFontPadding="false"/>

        <ImageView
            android:id="@+id/imgCrown"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_crown"
            app:tint="@color/LCYellow"/>

    </LinearLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rankProgress"
        android:layout_width="86dp"
        android:layout_height="86dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_dark_pill_panel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:src="@drawable/bg_dark_pill_panel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/S3" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/rankProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:progress="60"
            app:indicatorColor="@color/LCBlue"
            app:indicatorDirectionCircular="clockwise"
            app:indicatorSize="68dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:trackColor="@color/LCBG"
            app:trackThickness="8dp" />

        <ImageView
            android:id="@+id/rankBadgeIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_rank_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/LCBlue" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>