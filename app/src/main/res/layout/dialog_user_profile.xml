<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Caja principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dark_panel_rounded"
        android:padding="16dp">

        <include
            android:id="@+id/dialog_top_section"
            layout="@layout/dialog_common_popup_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Cabecera perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageProfileAvatar"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/bot1"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:contentDescription="@string/avatar"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtProfileUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/username"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/LCWhite"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtProfileLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nivel 77"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/LCGray"
                        android:layout_marginEnd="10dp" />

                    <ProgressBar
                        android:id="@+id/progressProfileXp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="60" />

                    <TextView
                        android:id="@+id/txtProfileXp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="123 xp"
                        android:textSize="13sp"
                        android:textColor="@color/LCGray"
                        android:layout_marginStart="10dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Botones acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonPrimaryAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/request_match"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/LCWhite"
                android:background="@drawable/bg_button"
                android:layout_marginEnd="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonSecondaryAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/delete"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/LCRed"
                android:background="@drawable/bg_button" />
        </LinearLayout>

        <!-- Encabezado tabla rankings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="@string/time_mode"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/LCWhite" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="0.8"

                android:src="@drawable/ic_crown"
                app:tint="@color/LCYellow"

                android:contentDescription="@string/elo"
                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:text="@string/rank"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/LCWhite"
                android:gravity="center" />
        </LinearLayout>

        <!-- Fila Blitz -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="@string/time_mode_blitz"
                android:textSize="18sp"
                android:textColor="@color/LCGray" />

            <TextView
                android:id="@+id/txtBlitzElo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:text="123"
                android:textSize="18sp"
                android:textColor="@color/LCGray"
                android:gravity="center" />

            <ImageView
                android:id="@+id/imageBlitzRank"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.8"

                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical"

                android:src="@drawable/ic_rank_placeholder"
                android:contentDescription="@string/blitz_rank"
                android:adjustViewBounds="true" />
        </LinearLayout>

        <!-- Fila Rapid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="@string/time_mode_rapid"
                android:textSize="18sp"
                android:textColor="@color/LCGray" />

            <TextView
                android:id="@+id/txtRapidElo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:text="122"
                android:textSize="18sp"
                android:textColor="@color/LCGray"
                android:gravity="center" />

            <ImageView
                android:id="@+id/imageRapidRank"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.8"

                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical"

                android:src="@drawable/ic_rank_placeholder"
                android:contentDescription="@string/rapid_rank"
                android:adjustViewBounds="true" />
        </LinearLayout>

        <!-- Fila Classic -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="@string/time_mode_classic"
                android:textSize="18sp"
                android:textColor="@color/LCGray" />

            <TextView
                android:id="@+id/txtClassicElo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:text="110"
                android:textSize="18sp"
                android:textColor="@color/LCGray"
                android:gravity="center" />

            <ImageView
                android:id="@+id/imageClassicRank"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.8"

                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical"

                android:src="@drawable/ic_rank_placeholder"
                android:contentDescription="@string/classic_rank"
                android:adjustViewBounds="true" />
        </LinearLayout>

        <!-- Fila Extended -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="@string/time_mode_extended"
                android:textSize="18sp"
                android:textColor="@color/LCGray" />

            <TextView
                android:id="@+id/txtExtendedElo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:text="153"
                android:textSize="18sp"
                android:textColor="@color/LCGray"
                android:gravity="center" />

            <ImageView
                android:id="@+id/imageExtendedRank"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="0.8"

                android:scaleType="fitCenter"
                android:layout_gravity="center_vertical"

                android:src="@drawable/ic_rank_placeholder"
                android:contentDescription="@string/extended_rank"
                android:adjustViewBounds="true" />
        </LinearLayout>

        <!-- Equipado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/equipped"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/LCWhite"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_surface2_panel_rounded"
                android:padding="12dp"
                android:layout_marginEnd="20dp">

                <ImageView
                    android:id="@+id/imagePieceSkin"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_piece_placeholder"
                    android:contentDescription="@string/piece_skin_desc" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/piece_skin"
                    android:textSize="11sp"
                    android:textColor="@color/LCWhite"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_surface2_panel_rounded"
                android:padding="12dp"
                android:layout_marginEnd="20dp">

                <ImageView
                    android:id="@+id/imageBoardSkin"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_board_placeholder"
                    android:contentDescription="@string/board_skin_desc" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/board_skin"
                    android:textSize="11sp"
                    android:textColor="@color/LCWhite"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_surface2_panel_rounded"
                android:padding="12dp" >

                <ImageView
                    android:id="@+id/imageWinAnimation"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_piece_placeholder"
                    android:contentDescription="@string/animation_desc" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/animation"
                    android:textSize="11sp"
                    android:textColor="@color/LCWhite"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>