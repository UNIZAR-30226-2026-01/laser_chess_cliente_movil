<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <androidx.cardview.widget.CardView
        android:layout_width="360dp"
        android:layout_height="560dp"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/S1"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <include
                android:id="@+id/dialog_top_section"
                layout="@layout/dialog_common_popup_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Estado vacío -->
            <TextView
                android:id="@+id/textHistoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="No hay partidas en el historial"
                android:textColor="@color/LCGray"
                android:visibility="gone"/>

            <!-- Progress mientras carga -->
            <ProgressBar
                android:id="@+id/progressHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:indeterminateTint="@color/LCBlue"
                android:visibility="visible"/>

            <!-- Lista de partidas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHistory"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:visibility="gone"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>