<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- TABLERO -->
    <FrameLayout
        android:id="@+id/boardContainerCustomize"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/S3"
        app:layout_constraintWidth_percent="0.82"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgBoardPlaceholderCustomize"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/board_skin" />

    </FrameLayout>

    <!-- SELECTOR DE PIEZAS -->
    <LinearLayout
        android:id="@+id/piecesSelectorContainer"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_shop_section"
        app:layout_constraintTop_toBottomOf="@id/boardContainerCustomize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnPreviousPieces"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/previous"
            app:tint="@color/LCWhite" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPiecesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Piezas · Soretro"
                android:textColor="@color/LCWhite"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/layoutPiecesPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgPiecePreview1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_piece_placeholder" />

                <ImageView
                    android:id="@+id/imgPiecePreview2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_piece_placeholder" />

                <ImageView
                    android:id="@+id/imgPiecePreview3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_piece_placeholder" />

                <ImageView
                    android:id="@+id/imgPiecePreview4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_piece_placeholder" />

                <ImageView
                    android:id="@+id/imgPiecePreview5"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_piece_placeholder" />

            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNextPieces"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_left"
            android:rotation="180"
            android:contentDescription="@string/next"
            app:tint="@color/LCWhite" />

    </LinearLayout>

    <!-- FILA INFERIOR -->
    <LinearLayout
        android:id="@+id/bottomSelectorsContainer"
        android:layout_width="0dp"
        android:layout_height="144dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        app:layout_constraintTop_toBottomOf="@id/piecesSelectorContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- SELECTOR TABLERO -->
        <LinearLayout
            android:id="@+id/boardSkinContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_shop_section">

            <TextView
                android:id="@+id/txtBoardSkinTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tablero · Soretro"
                android:textColor="@color/LCWhite"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPreviousBoard"
                    android:layout_width="22dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="@string/previous"
                    app:tint="@color/LCWhite" />

                <ImageView
                    android:id="@+id/imgBoardPreview"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="1dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_board_placeholder" />

                <ImageButton
                    android:id="@+id/btnNextBoard"
                    android:layout_width="22dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_left"
                    android:rotation="180"
                    android:contentDescription="@string/next"
                    app:tint="@color/LCWhite" />

            </LinearLayout>
        </LinearLayout>

        <!-- SELECTOR AVATAR -->
        <LinearLayout
            android:id="@+id/avatarContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_shop_section">

            <TextView
                android:id="@+id/txtAvatarTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Avatar ·"
                android:textColor="@color/LCWhite"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPreviousAvatar"
                    android:layout_width="22dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="@string/previous"
                    app:tint="@color/LCWhite" />

                <ImageView
                    android:id="@+id/imgAvatarPreview"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="1dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar" />

                <ImageButton
                    android:id="@+id/btnNextAvatar"
                    android:layout_width="22dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_left"
                    android:rotation="180"
                    android:contentDescription="@string/next"
                    app:tint="@color/LCWhite" />

            </LinearLayout>
        </LinearLayout>

        <!-- SELECTOR ANIMACIÓN -->
        <LinearLayout
            android:id="@+id/animationSkinContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_shop_section">

            <TextView
                android:id="@+id/txt_animation_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Victoria · Soretro"
                android:textColor="@color/LCWhite"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPreviousAnimation"
                    android:layout_width="22dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="@string/previous"
                    app:tint="@color/LCWhite" />

                <ImageView
                    android:id="@+id/imgAnimationPreview"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="1dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_piece_placeholder" />

                <ImageButton
                    android:id="@+id/btnNextAnimation"
                    android:layout_width="22dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_left"
                    android:rotation="180"
                    android:contentDescription="@string/next"
                    app:tint="@color/LCWhite" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>