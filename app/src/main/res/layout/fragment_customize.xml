<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- TABLERO -->
    <FrameLayout
        android:id="@+id/boardContainerCustomize"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@color/S3"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgBoardPlaceholderCustomize"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Board"/>

    </FrameLayout>


    <!-- SELECTOR DE PIEZAS -->
    <LinearLayout
        android:id="@+id/piecesSelectorContainer"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:background="@drawable/bg_shop_section"
        app:layout_constraintTop_toBottomOf="@id/boardContainerCustomize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" >

        <ImageButton
            android:id="@+id/btnPreviousPieces"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/previous"
            app:tint="@color/LCWhite" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtPiecesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Piezas · Soretro"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/layoutPiecesPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgPiecePreview1"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/ic_piece_placeholder" />

                <ImageView
                    android:id="@+id/imgPiecePreview2"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/ic_piece_placeholder" />

                <ImageView
                    android:id="@+id/imgPiecePreview3"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/ic_piece_placeholder" />

                <ImageView
                    android:id="@+id/imgPiecePreview4"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/ic_piece_placeholder" />

                <ImageView
                    android:id="@+id/imgPiecePreview5"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/ic_piece_placeholder" />

            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNextPieces"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="@string/next"
            app:tint="@color/LCWhite" />

    </LinearLayout>


    <!-- FILA INFERIOR: TABLERO / AVATAR / VICTORIA -->
    <LinearLayout
        android:id="@+id/bottomSelectorsContainer"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false"
        app:layout_constraintTop_toBottomOf="@id/piecesSelectorContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <!-- SELECTOR TABLERO -->
        <LinearLayout
            android:id="@+id/boardSkinContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/bg_shop_section">

            <TextView
                android:id="@+id/txtBoardSkinTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tablero · Soretro"
                android:textColor="@color/LCWhite"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPreviousBoard"
                    android:layout_width="24dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="@string/previous"
                    app:tint="@color/LCWhite" />

                <ImageView
                    android:id="@+id/imgBoardPreview"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_board_placeholder" />

                <ImageButton
                    android:id="@+id/btnNextBoard"
                    android:layout_width="24dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@string/next"
                    app:tint="@color/LCWhite" />

            </LinearLayout>
        </LinearLayout>


        <!-- SELECTOR AVATAR -->
        <LinearLayout
            android:id="@+id/avatarContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/bg_shop_section">

            <TextView
                android:id="@+id/txtAvatarTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Avatar · mr pollo"
                android:textColor="@color/LCWhite"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPreviousAvatar"
                    android:layout_width="24dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="@string/previous"
                    app:tint="@color/LCWhite" />

                <ImageView
                    android:id="@+id/imgAvatarPreview"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginHorizontal="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar" />

                <ImageButton
                    android:id="@+id/btnNextAvatar"
                    android:layout_width="24dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@string/next"
                    app:tint="@color/LCWhite" />

            </LinearLayout>
        </LinearLayout>


        <!-- SELECTOR ANIMACIÓN -->
        <LinearLayout
            android:id="@+id/animationSkinContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:background="@drawable/bg_shop_section">

            <TextView
                android:id="@+id/txt_animation_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Victoria · Soretro"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPreviousAnimation"
                    android:layout_width="24dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_left"
                    android:contentDescription="@string/previous"
                    app:tint="@color/LCWhite" />

                <ImageView
                    android:id="@+id/imgAnimationPreview"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="2dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_piece_placeholder" />

                <ImageButton
                    android:id="@+id/btnNextAnimation"
                    android:layout_width="24dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription="@string/next"
                    app:tint="@color/LCWhite" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>